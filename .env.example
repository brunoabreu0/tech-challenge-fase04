APP_ENV=development
APP_NAME=credit-scoring-observability-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
RANDOM_SEED=42

# Diretórios de dados, modelos e relatórios
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODEL_DIR=models
REPORTS_DIR=reports

# Configurações de Qualidade de Dados e Drift
DEFAULT_MODEL_TYPE=xgboost
REFERENCE_SAMPLES=6000
PRODUCTION_SAMPLES=3000
PSI_WARNING_THRESHOLD=0.10
PSI_CRITICAL_THRESHOLD=0.25
KS_ALPHA=0.05

# MLflow Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=credit-scoring-drift-monitoring

# Governança e Privacidade (LGPD)
PII_HASH_SALT=fiap-postech-9mlet-fase04-salt
DATA_RETENTION_DAYS=1825

# AWS (apenas para CI/CD e produção)
AWS_DEFAULT_REGION=sa-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
